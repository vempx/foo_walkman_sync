#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "resource.h"
IDD_PREF DIALOGEX 0,0,276,206
STYLE DS_CONTROL | DS_SETFONT | WS_CHILD | WS_VISIBLE
FONT 8,"MS Shell Dlg"
BEGIN
LTEXT "已添加设备",-1,5,8,53,10
COMBOBOX DEVICES,62,5,103,84,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
PUSHBUTTON "添加设备…",ADD,168,4,50,15
PUSHBUTTON "删除设备…",DELETE_DEVICE,221,4,50,15
LTEXT "菜单名称",-1,5,27,53,10
EDITTEXT NAME,62,24,209,14,ES_AUTOHSCROLL
LTEXT "音乐根目录",-1,5,45,53,10
EDITTEXT ROOTDIR,62,42,209,14,ES_AUTOHSCROLL
LTEXT "路径模板",-1,5,63,53,10
EDITTEXT PATTERN,62,60,209,14,ES_AUTOHSCROLL
PUSHBUTTON "省略空目录",USE_PATTERN,5,76,53,13
LTEXT "",PREVIEW,62,77,209,11,SS_PATHELLIPSIS | SS_NOPREFIX
LTEXT "",PREVIEW_FILE,62,88,209,11,SS_ENDELLIPSIS | SS_NOPREFIX
LTEXT "音频传输",-1,5,104,53,10
COMBOBOX FORMAT,62,101,148,50,CBS_DROPDOWNLIST | WS_TABSTOP
PUSHBUTTON "编码设置…",AUDIO,215,100,56,15
LTEXT "订阅的播放列表",-1,5,124,129,11
CONTROL "",SUBS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | LVS_NOSORTHEADER | WS_TABSTOP | WS_BORDER,5,136,266,35
CONTROL "设备连接时自动同步已勾选的歌单",AUTO_SYNC,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,172,212,13
PUSHBUTTON "同步所有订阅播放列表",SYNC_ALL,5,186,101,16
PUSHBUTTON "同步记录…",REPORTS,150,186,56,16
PUSHBUTTON "清空本地记录…",CLEAR_RECORDS,209,186,62,16
END
IDD_AUDIO DIALOGEX 0,0,286,218
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "设备编码设置"
FONT 8,"MS Shell Dlg"
BEGIN
LTEXT "编码格式",-1,8,10,44,12
COMBOBOX CODEC,55,7,146,126,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
PUSHBUTTON "新增…",ADD_CODEC,204,6,36,15
PUSHBUTTON "编辑…",EDIT_CODEC,242,6,36,15
LTEXT "比特率模式",MODE_LABEL,8,34,100,12
COMBOBOX AACMODE,127,31,151,70,CBS_DROPDOWNLIST | WS_TABSTOP
LTEXT "VBR 品质 (0–127)",QUALITY_LABEL,8,55,117,12
EDITTEXT QUALITY,127,52,50,14,ES_NUMBER
PUSHBUTTON "配置 DSP 链…",CHAIN,185,51,93,16
CONTROL "按采样率系列降采样",DOWNSAMPLE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,8,79,202,14
LTEXT "重采样器",-1,8,102,106,12
COMBOBOX RESAMPLER,127,99,151,85,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT "44.1 kHz 系列目标",-1,8,122,106,12
COMBOBOX RATE44,127,119,98,85,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT "48 kHz 系列目标",-1,8,142,106,12
COMBOBOX RATE48,127,139,98,85,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
LTEXT "仅处理高于对应目标的音源。",-1,8,166,245,12
DEFPUSHBUTTON "确定",IDOK,166,194,53,16
PUSHBUTTON "取消",IDCANCEL,225,194,53,16
END
IDD_CUSTOM DIALOGEX 0,0,292,175
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | DS_SETFONT
CAPTION "自定义命令行编码器"
FONT 8,"MS Shell Dlg"
BEGIN
LTEXT "名称",-1,8,10,54,12
EDITTEXT NAME,66,7,217,14,ES_AUTOHSCROLL
LTEXT "程序",-1,8,30,54,12
EDITTEXT PROGRAM,66,27,170,14,ES_AUTOHSCROLL
PUSHBUTTON "浏览…",BROWSE_EXE,239,26,44,16
LTEXT "扩展名",-1,8,50,54,12
EDITTEXT EXTENSION,66,47,65,14,ES_AUTOHSCROLL
LTEXT "输入 PCM",-1,140,50,48,12
COMBOBOX PRECISION,188,47,95,80,CBS_DROPDOWNLIST | WS_TABSTOP
LTEXT "命令行参数",-1,8,71,54,12
EDITTEXT ARGUMENTS,66,68,217,14,ES_AUTOHSCROLL
LTEXT "%d 为输出文件。使用 %s 读取临时 WAV，省略 %s 时从标准输入读取 WAV。",-1,8,93,275,26
LTEXT "程序可填写 encoders 目录中的文件名或完整路径。",-1,8,122,275,17
PUSHBUTTON "移除",REMOVE_CODEC,8,151,44,16
DEFPUSHBUTTON "确定",IDOK,171,151,53,16
PUSHBUTTON "取消",IDCANCEL,230,151,53,16
END
